# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# ─── SOURCE DATABASE (PostgreSQL — e-invoicing system) ─────────────────────
# The pipeline reads from the `invoices` table (and related tables) here.
SOURCE_HOST=
SOURCE_PORT=5432
SOURCE_DB=
SOURCE_USER=
SOURCE_PASSWORD=

# Max size of the Postgres connection pool used for reading source data.
PG_POOL_SIZE=4

# ─── DESTINATION DATABASE (SQL Server — data warehouse) ─────────────────────
# The pipeline writes transformed rows into DEST_SERVER's dbo.factInvoice table.
DEST_SERVER=
DEST_PORT=1433
DEST_DB=
DEST_DOMAIN=
DEST_USER=
DEST_PASSWORD=

# ─── TELEGRAM NOTIFICATIONS (optional) ──────────────────────────────────────
# If set, the pipeline sends a Telegram message on start, on each completed
# batch, on each failed batch, and when the full run finishes.
# Leave both blank to disable notifications (failures are swallowed silently).
#
# How to set this up:
#   1. Message @BotFather on Telegram, run /newbot, and follow the prompts.
#      BotFather will give you a bot token that looks like:
#      123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
#   2. Add your new bot to the chat/group you want alerts in (or message it
#      directly for a private DM).
#   3. Get the chat ID:
#      - For a DM: message your bot, then open
#        https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser
#        and read the "chat":{"id": ...} field.
#      - For a group: add the bot to the group, send any message in the
#        group, then hit the same getUpdates URL — group chat IDs are
#        negative numbers (e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── PIPELINE TUNING ─────────────────────────────────────────────────────────
# Directory where progress.json, failed_ranges.json, metrics.json and daily
# log files are written. Must be writable by the process.
LOGS_DIR=/Users/user/Documents/pipeline-logs

# Number of source rows fetched per SELECT batch (by id range).
BATCH_SIZE=250000

# Number of rows per single INSERT...VALUES statement sent to the destination.
INSERT_CHUNK=5000

# Number of batches processed in parallel (also sizes the destination
# connection pool — keep CONCURRENCY <= your SQL Server pool/license limits).
CONCURRENCY=2
